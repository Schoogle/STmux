/* Global Screen Setup - Soft Charcoal */
Screen {
    background: #1e1e1e;
    color: #dcdcdc;
}

/* Header & Footer */
Header {
    background: #252525;
    color: #61afef;
    height: 1;
    text-style: bold;
}

Footer {
    background: #252525;
    color: #98c379;
    height: 1;
}

Horizontal {
    padding: 0;
    margin: 0;
}

#left-pane {
    width: 30%;
    border: round #61afef;
    background: #252525;
    height: 100%;
    padding: 0 1;
    margin: 0;
}

#right-pane {
    width: 70%;
    border: round #98c379;
    background: #252525;
    height: 100%;
    padding: 0 1;
    margin: 0;
}

/* OptionList with border: none to eliminate the inner box */
OptionList {
    border: none;
    background: #252525;
    height: 100%;
    scrollbar-color: #5c6370;
    scrollbar-gutter: stable;
}

OptionList > .option-list--option {
    color: #abb2bf;
    padding: 0 1;
}

/* Full-width edge-to-edge selection highlight */
OptionList > .option-list--option-highlighted {
    background: #3e4451;
    color: #e5c07b;
    text-style: bold;
}

/* Modal Dialog */
#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 1 2;
    width: 46;
    height: 9;
    border: round #e5c07b;
    background: #21252b;
}

#dialog Label {
    color: #dcdcdc;
    text-style: bold;
}

Input {
    background: #1e1e1e;
    border: solid #61afef;
    color: #dcdcdc;
    height: 3;
}

Input:focus {
    border: solid #98c379;
}