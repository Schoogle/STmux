/* Global Screen Setup - Soft Charcoal */
Screen {
    background: #1e1e1e;
    color: #dcdcdc;
}

/* Header & Footer */
Header {
    background: #252525;
    color: #61afef;
    height: 1;
    text-style: bold;
}

Footer {
    background: #252525;
    color: #98c379;
    height: 1;
}

Horizontal {
    padding: 0;
    margin: 0;
}

#left-pane {
    width: 20%;
    border: round #61afef;
    background: #252525;
    height: 100%;
    padding: 0 1;
    margin: 0;
}

#right-pane {
    width: 80%;
    border: round #98c379;
    background: #252525;
    height: 100%;
    padding: 0 1;
    margin: 0;
}

/* OptionList with border: none to eliminate the inner box */
OptionList {
    border: none;
    background: #252525;
    height: 100%;
    scrollbar-color: #5c6370;
    scrollbar-gutter: stable;
}

OptionList > .option-list--option {
    color: #abb2bf;
    padding: 0 1;
}

/* Full-width edge-to-edge selection highlight */
OptionList > .option-list--option-highlighted {
    background: #3e4451;
    color: #e5c07b;
    text-style: bold;
}

/* Modal Dialog */
#dialog {
    padding: 1 2;
    width: 46;
    height: auto;
    border: round #e5c07b;
    background: #21252b;
}
    
#dialog Label {
    color: #dcdcdc;
    text-style: bold;
}

Input {
    background: #1e1e1e;
    border: solid #61afef;
    color: #dcdcdc;
    height: 3;
}

Input:focus {
    border: solid #98c379;
}

#dialog-buttons {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1; /* Pushed much closer to the text! */
}

Button {
    height: 3;
    min-width: 14;
    background: #1e1e1e;
    border: solid #5c6370; /* Muted grey border when not selected */
    color: #abb2bf;
    margin: 0 1;
}

Button#cancel:focus {
    border: double #61afef; /* Neon blue to match the left pane */
    color: #61afef;
    text-style: bold;
}

Button#ok:focus {
    border: double #e06c75; /* Soft red to indicate deletion */
    color: #e06c75;
    text-style: bold;
}

.hidden {
    display: none;
}

#search-input {
    height: 3;
    border: solid #61afef;
    background: #1e1e1e;
    color: #dcdcdc;
    margin-bottom: 1; 
}

#search-input:focus {
    border: double #e5c07b; 
}

#preview-container {
    height: 100%;
    overflow: auto auto; /* The container handles the scrolling natively */
    scrollbar-color: #5c6370;
}

#preview-window {
    height: auto; /* Allows the text to grow infinitely tall inside the container */
}

#right-pane:focus-within {
    border: round #e5c07b;
}

